  m_Script: {fileID: 11500000, guid: 87b90d9addd26c44d8e252e2debcd193, type: 3}
  m_Name: DLG_Examinar_CabezaClava
  m_EditorClassIdentifier: Assembly-CSharp::Huantar.Narrative.DialogueData
  blocking: 0
  lines:
  - speaker: 
    text: "Una cabeza de piedra, medio enterrada en el barro. Tiene colmillos. Y por detr\xE1s, una espiga, como si alguna vez hubiera estado clavada en un muro."
