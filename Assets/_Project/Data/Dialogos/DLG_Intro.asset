  m_Script: {fileID: 11500000, guid: 87b90d9addd26c44d8e252e2debcd193, type: 3}
  m_Name: DLG_Intro
  m_EditorClassIdentifier: Assembly-CSharp::Huantar.Narrative.DialogueData
  blocking: 1
  lines:
  - speaker: 
    text: "Valle de Hu\xE1ntar, a\xF1o de 1611."
  - speaker: 
    text: "El pueblo nos acus\xF3 de \xF1akaq. Al L\xEDder lo mataron frente a la iglesia. Del padre no supe m\xE1s."
  - speaker: 
    text: "Solo el indio que nos guiaba me sac\xF3 de all\xED. Me dio su farol y cruz\xF3 el r\xEDo a buscar otro camino."
  - speaker: 
    text: Me dijo que no me detuviera. Que en la quebrada, de noche, algo camina.
  - speaker: 'Controles:'
    text: 'WASD: moverse     Shift: correr     Ctrl: agacharse

      F: farol     E: examinar     Tab: cuaderno     Esc: pausa'
